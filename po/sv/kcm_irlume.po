#: src/backend/authconfiguration.cpp:13
msgid "AuthConfiguration"
msgstr "Autentisering"

#: src/backend/authconfiguration.cpp:25
msgid "Preview a change before enabling face authentication."
msgstr "Autentisering"

#: src/backend/authconfiguration.cpp:62
msgid "Updating read-only authentication wiring…"
msgstr "Uppdaterar skrivskyddad autentiseringsinkoppling…"

#: src/backend/authconfiguration.cpp:88
msgid "The read-only authentication wiring status is unavailable."
msgstr ""
"Status för den skrivskyddade autentiseringsinkopplingen är inte tillgänglig."

#: src/backend/authconfiguration.cpp:91
msgid "The backend does not advertise read-only authentication wiring."
msgstr "Bakänden annonserar inte skrivskyddad autentiseringsinkoppling."

#: src/backend/authconfiguration.cpp:94
msgid ""
"Authentication wiring is shown read-only. Contract 1 does not support "
"configuration changes."
msgstr ""
"Autentiseringsinkopplingen visas skrivskyddad. Contract 1 stöder inte "
"konfigurationsändringar."

#: src/backend/authconfiguration.cpp:211 src/backend/authconfiguration.cpp:227
#: src/backend/authconfiguration.cpp:244 src/backend/authconfiguration.cpp:260
#: src/backend/authconfiguration.cpp:283 src/backend/authconfiguration.cpp:306
#: src/backend/authconfiguration.cpp:322 src/backend/authconfiguration.cpp:341
#: src/backend/authconfiguration.cpp:462
msgid "Contract 1 does not support authentication configuration changes."
msgstr "Contract 1 stöder inte ändringar av autentiseringskonfigurationen."

#: src/backend/authconfiguration.cpp:216
msgid "Lock-screen activation is not ready."
msgstr "Aktivering på inloggningsskärmen kräver säker infraröd nivå."

#: src/backend/authconfiguration.cpp:219
msgid "Lock-screen face unlock"
msgstr "Ansiktsupplåsning på låsskärmen"

#: src/backend/authconfiguration.cpp:233
msgid "Login-screen activation requires the Secure infrared tier."
msgstr "Aktivering på inloggningsskärmen kräver säker infraröd nivå."

#: src/backend/authconfiguration.cpp:236
msgid "Login-screen face authentication"
msgstr "Autentisering"

#: src/backend/authconfiguration.cpp:249
msgid "Face authentication cannot be disabled here."
msgstr ""
"Ansiktsautentisering för sudo, su, SSH och Polkit ingår inte i V2 och kan "
"inte aktiveras här."

#: src/backend/authconfiguration.cpp:252
msgid "Disable face authentication"
msgstr "Autentisering"

#: src/backend/authconfiguration.cpp:266 src/backend/authconfiguration.cpp:289
msgid "Read and acknowledge the TTY recovery command before enabling."
msgstr "Jag har läst TTY-kommandot för återställning"

#: src/backend/authconfiguration.cpp:272
msgid "Preview the lock-screen plan before enabling."
msgstr "Granska återställning före aktivering"

#: src/backend/authconfiguration.cpp:295
msgid "Preview the login-screen plan before enabling."
msgstr "Granska återställning före aktivering"

#: src/backend/authconfiguration.cpp:311
msgid "Preview the disable plan before applying it."
msgstr "Förhandsgranska inaktiveringsplanen innan den tillämpas."

#: src/backend/authconfiguration.cpp:328
msgid "Face authentication cannot be disabled safely from this session."
msgstr ""
"Ansiktsautentisering kan inte inaktiveras säkert från den här sessionen."

#: src/backend/authconfiguration.cpp:351
msgid "Restoring the previous authentication configuration…"
msgstr "Autentisering"

#: src/backend/authconfiguration.cpp:355
msgid "Rollback could not be started."
msgstr "Återställningen kunde inte startas."

#: src/backend/authconfiguration.cpp:368
msgid "Asking irlume for a non-mutating plan…"
msgstr "Begär en icke-ändrande plan från irlume…"

#: src/backend/authconfiguration.cpp:372
msgid "The preview could not be started."
msgstr "Förhandsvisningen kunde inte startas."

#: src/backend/authconfiguration.cpp:381
msgid "Applying, verifying, and protecting password fallback…"
msgstr "Tillämpar, verifierar och skyddar lösenordsreserven…"

#: src/backend/authconfiguration.cpp:386
msgid "The authentication change could not be started."
msgstr "Autentisering"

#: src/backend/authconfiguration.cpp:402
msgid "The previous configuration was restored automatically."
msgstr "Den tidigare konfigurationen återställdes automatiskt."

#: src/backend/authconfiguration.cpp:415
msgid "The plan is read-only. Review it before applying the change."
msgstr "Planen är skrivskyddad. Granska den innan ändringen tillämpas."

#: src/backend/authconfiguration.cpp:423
msgid "The previous authentication configuration was restored."
msgstr "Autentisering"

#: src/backend/authconfiguration.cpp:444
msgid ""
"Authentication changed and verified. Password fallback remains available."
msgstr ""
"Autentiseringen ändrades och verifierades. Lösenordsreserven är fortsatt "
"tillgänglig."

#: src/backend/authconfiguration.cpp:466
msgid ""
"The installed irlume release does not provide the reviewed login-transaction "
"contract."
msgstr ""
"Den installerade irlume-versionen tillhandahåller inte det granskade avtalet "
"för inloggningstransaktioner."

#: src/backend/authconfiguration.cpp:470
msgid "Administrator authentication was cancelled. Nothing was changed."
msgstr "Administratörsautentiseringen avbröts. Ingenting ändrades."

#: src/backend/authconfiguration.cpp:474
msgid "Login-screen face authentication requires the Secure infrared tier."
msgstr "Aktivering på inloggningsskärmen kräver säker infraröd nivå."

#: src/backend/authconfiguration.cpp:478
msgid "Post-apply verification failed."
msgstr "Verifieringen efter tillämpning misslyckades."

#: src/backend/authconfiguration.cpp:482
msgid ""
"Automatic rollback could not be confirmed. Use the TTY recovery command now."
msgstr ""
"Automatisk återställning kunde inte bekräftas. Använd TTY-kommandot för "
"återställning nu."

#: src/backend/authconfiguration.cpp:484
msgid ""
"The authentication operation failed without a verified configuration change."
msgstr ""
"Autentiseringsåtgärden misslyckades utan en verifierad konfigurationsändring."

