#: src/backend/supportreport.cpp:22
msgid "SupportReport"
msgstr "Support"

#: src/backend/supportreport.cpp:78
msgid ""
"1. Press Ctrl+Alt+F3 to open a text console.\n"
"2. Sign in with your existing password.\n"
"3. Run: sudo irlume login disable --apply\n"
"4. Run: authselect check\n"
"5. Run: systemctl status irlumed --no-pager\n"
"6. Confirm password authentication before logging out or rebooting."
msgstr ""
"1. Tryck Ctrl+Alt+F3 för att öppna en textkonsol.\n"
"2. Logga in med ditt befintliga lösenord.\n"
"3. Kör: sudo irlume login disable --apply\n"
"4. Kör: authselect check\n"
"5. Kör: systemctl status irlumed --no-pager\n"
"6. Bekräfta lösenordsautentisering innan du loggar ut eller startar om."

