#: src/preview/cameraprovider.cpp:192
msgctxt "CameraProvider"
msgid "Camera"
msgstr "Kamera"

#: src/kcm/ui/CameraCheckPage.qml:19 src/kcm/ui/CameraCheckPage.qml:38
#: src/kcm/ui/main.qml:31
msgid "Camera Check"
msgstr "Kamerakontroll"

#: src/kcm/ui/CameraCheckPage.qml:46
msgid ""
"Preview starts only when you ask. Frames remain in memory, stop after 60 "
"seconds, and are never used for enrollment or recognition."
msgstr ""
"Förhandsvisningen startar endast när du begär det. Bildrutor stannar i "
"minnet, stoppas efter 60 sekunder och används aldrig för registrering eller "
"igenkänning."

#: src/kcm/ui/CameraCheckPage.qml:53
msgid ""
"A visible RGB or infrared image does not verify liveness, identity, security "
"level, or authentication readiness."
msgstr ""
"En synlig RGB- eller infraröd bild verifierar inte livskontroll, identitet, "
"säkerhetsnivå eller autentiseringsberedskap."

#: src/kcm/ui/CameraCheckPage.qml:68
msgid "Local camera"
msgstr "Lokal kamera"

#: src/kcm/ui/CameraCheckPage.qml:75
msgid "Refresh"
msgstr "Uppdatera"

#: src/kcm/ui/CameraCheckPage.qml:88
msgid "Private camera preview"
msgstr "Privat kameraförhandsvisning"

#: src/kcm/ui/CameraCheckPage.qml:102
msgid "Infrared camera preview"
msgstr "Förhandsvisning från infraröd kamera"

#: src/kcm/ui/CameraCheckPage.qml:104
msgid "RGB camera preview"
msgstr "Förhandsvisning från RGB-kamera"

#: src/kcm/ui/CameraCheckPage.qml:105
msgid "Camera preview"
msgstr "Kameraförhandsvisning"

#: src/kcm/ui/CameraCheckPage.qml:112
msgid "Starting camera…"
msgstr "Startar kameran…"

#: src/kcm/ui/CameraCheckPage.qml:113
msgid "Preview is off"
msgstr "Förhandsvisningen är avstängd"

#: src/kcm/ui/CameraCheckPage.qml:126
msgid "%1 s"
msgstr "%1 s"

#: src/kcm/ui/CameraCheckPage.qml:158
msgid "Stop preview"
msgstr "Stoppa förhandsvisning"

#: src/kcm/ui/CameraCheckPage.qml:158
msgid "Start preview"
msgstr "Starta förhandsvisning"

#: src/kcm/ui/CameraCheckPage.qml:176
msgid "Dropped preview frames: %1"
msgstr "Tappade bildrutor i förhandsvisningen: %1"

#: src/kcm/ui/CameraCheckPage.qml:189
msgid ""
"Analyze uses local YuNet face detection for one current frame. It does not "
"identify a person, test liveness, or make an authentication decision."
msgstr ""
"Analysen använder lokal YuNet-ansiktsdetektering för en aktuell bildruta. "
"Den identifierar inte en person, testar inte livskontroll och fattar inget "
"autentiseringsbeslut."

#: src/kcm/ui/CameraCheckPage.qml:213
msgid "Analyze current frame"
msgstr "Analysera aktuell bildruta"

#: src/kcm/ui/CameraCheckPage.qml:225
msgid "No face was found in this frame."
msgstr "Inget ansikte hittades i den här bildrutan."

#: src/kcm/ui/CameraCheckPage.qml:227
msgid "One face was found in this frame."
msgstr "Ett ansikte hittades i den här bildrutan."

#: src/kcm/ui/CameraCheckPage.qml:228
msgid "Multiple faces were found in this frame."
msgstr "Flera ansikten hittades i den här bildrutan."

#: src/kcm/ui/CameraCheckPage.qml:240
msgid "Center your face in the frame."
msgstr "Centrera ansiktet i bildrutan."

#: src/kcm/ui/CameraCheckPage.qml:247
msgid "Move closer to the camera."
msgstr "Flytta närmare kameran."

#: src/kcm/ui/CameraCheckPage.qml:254
msgid "Move farther from the camera."
msgstr "Flytta längre bort från kameran."

#: src/kcm/ui/CameraCheckPage.qml:261
msgid "Add more even light."
msgstr "Lägg till mer jämn belysning."

#: src/kcm/ui/CameraCheckPage.qml:268
msgid "Reduce bright light on your face."
msgstr "Minska starkt ljus mot ansiktet."

#: src/kcm/ui/CameraCheckPage.qml:275
msgid "Use more even front lighting."
msgstr "Använd jämnare belysning framifrån."

#: src/kcm/ui/CameraCheckPage.qml:282
msgid "Hold still and check that the camera lens is clear."
msgstr "Håll stilla och kontrollera att kameralinsen är ren."

#: src/kcm/ui/CameraCheckPage.qml:293
msgid "Framing and image quality are suitable for this development check."
msgstr ""
"Inramning och bildkvalitet är lämpliga för den här utvecklingskontrollen."

#: src/kcm/ui/DiagnosticsPage.qml:19 src/kcm/ui/main.qml:37
msgid "Diagnostics"
msgstr "Diagnostik"

#: src/kcm/ui/DiagnosticsPage.qml:30
msgid ""
"Diagnostics are read-only. Refreshing runs bounded local probes and never "
"performs biometric or PAM operations."
msgstr ""
"Diagnostiken är skrivskyddad. Uppdatering kör begränsade lokala kontroller "
"och utför aldrig biometriska åtgärder eller PAM-åtgärder."

#: src/kcm/ui/DiagnosticsPage.qml:43
msgid "Native status"
msgstr "Native-status"

#: src/kcm/ui/DiagnosticsPage.qml:48 src/kcm/ui/SetupStatusPage.qml:82
msgid "Native engine"
msgstr "Native-motor"

#: src/kcm/ui/DiagnosticsPage.qml:57 src/kcm/ui/SetupStatusPage.qml:109
msgid "Enrollment"
msgstr "Registrering"

#: src/kcm/ui/DiagnosticsPage.qml:66
msgid "Authentication decisions"
msgstr "Autentiseringsbeslut"

#: src/kcm/ui/DiagnosticsPage.qml:75
msgid "PAM configuration"
msgstr "PAM-konfiguration"

#: src/kcm/ui/DiagnosticsPage.qml:84
msgid "Template persistence"
msgstr "Beständig mallagring"

#: src/kcm/ui/DiagnosticsPage.qml:93
msgid "Secure Boot"
msgstr "Säker start"

#: src/kcm/ui/DiagnosticsPage.qml:100 src/kcm/ui/SetupStatusPage.qml:57
msgid "Updating…"
msgstr "Uppdaterar…"

#: src/kcm/ui/DiagnosticsPage.qml:100
msgid "Refresh diagnostics"
msgstr "Uppdatera diagnostik"

#: src/kcm/ui/DiagnosticsPage.qml:111
msgid "Redacted support report preview"
msgstr "Förhandsvisning av maskerad supportrapport"

#: src/kcm/ui/DiagnosticsPage.qml:121
msgid "Redacted support report"
msgstr "Maskerad supportrapport"

#: src/kcm/ui/DiagnosticsPage.qml:129
msgid "Copy report"
msgstr "Kopiera rapport"

#: src/kcm/ui/DiagnosticsPage.qml:135
msgid "Export report"
msgstr "Exportera rapport"

#: src/kcm/ui/DiagnosticsPage.qml:137
msgid "Saves a redacted Markdown report in Documents"
msgstr "Sparar en maskerad Markdown-rapport i Dokument"

#: src/kcm/ui/SetupStatusPage.qml:20 src/kcm/ui/main.qml:25
msgid "Overview"
msgstr "Översikt"

#: src/kcm/ui/SetupStatusPage.qml:31
msgid ""
"Milestone 3 adds explicit local YuNet face-presence detection to Camera "
"Check. It does not recognize people, test liveness, enroll profiles, store "
"biometric data, configure PAM, or authenticate users."
msgstr ""
"Milstolpe 3 lägger till uttrycklig lokal YuNet-detektering av ansiktsnärvaro "
"i kamerakontrollen. Den känner inte igen personer, testar inte livskontroll, "
"registrerar inte profiler, lagrar inte biometriska data, konfigurerar inte "
"PAM och autentiserar inte användare."

#: src/kcm/ui/SetupStatusPage.qml:57
msgid "Refresh status"
msgstr "Uppdatera status"

#: src/kcm/ui/SetupStatusPage.qml:64
msgid "Open Camera Check"
msgstr "Öppna kamerakontroll"

#: src/kcm/ui/SetupStatusPage.qml:75
msgid "Milestone status"
msgstr "Status för milstolpen"

#: src/kcm/ui/SetupStatusPage.qml:91
msgid "Local cameras"
msgstr "Lokala kameror"

#: src/kcm/ui/SetupStatusPage.qml:92
msgid "%1 camera found"
msgid_plural "%1 cameras found"
msgstr[0] "%1 kamera hittades"
msgstr[1] "%1 kameror hittades"

#: src/kcm/ui/SetupStatusPage.qml:100
msgid "Vision processing"
msgstr "Bildbehandling"

#: src/kcm/ui/SetupStatusPage.qml:101
msgid "Local Camera Check only"
msgstr "Endast lokal kamerakontroll"

#: src/kcm/ui/SetupStatusPage.qml:118
msgid "Authentication and PAM"
msgstr "Autentisering och PAM"

#: src/kcm/ui/main.qml:13
msgid "KFaceAuth (Development Preview)"
msgstr "KFaceAuth (utvecklingsförhandsvisning)"

#: src/kcm/ui/main.qml:20
msgid "KFaceAuth sections"
msgstr "KFaceAuth-avsnitt"

#: src/backend/camerapreviewsession.cpp:22
msgid "CameraPreviewSession"
msgstr "Kameraförhandsvisningssession"

#: src/backend/camerapreviewsession.cpp:213
#: src/backend/camerapreviewsession.cpp:313
msgid "Looking for local cameras…"
msgstr "Söker efter lokala kameror…"

#: src/backend/camerapreviewsession.cpp:227
msgid "Starting the selected camera…"
msgstr "Startar den valda kameran…"

#: src/backend/camerapreviewsession.cpp:242
msgid "Stopping and releasing the camera…"
msgstr "Stoppar och frigör kameran…"

#: src/backend/camerapreviewsession.cpp:386
msgid "Preview is live and remains only in memory."
msgstr "Förhandsvisningen är aktiv och stannar endast i minnet."

#: src/backend/camerapreviewsession.cpp:401
msgid "The camera has been released."
msgstr "Kameran har frigjorts."

#: src/backend/camerapreviewsession.cpp:453
msgid "Select a camera and start a private preview."
msgstr "Välj en kamera och starta en privat förhandsvisning."

#: src/backend/camerapreviewsession.cpp:534
msgid "Camera permission was denied."
msgstr "Kamerabehörighet nekades."

#: src/backend/camerapreviewsession.cpp:536
msgid "No compatible local camera was found."
msgstr "Ingen kompatibel lokal kamera hittades."

#: src/backend/camerapreviewsession.cpp:538
msgid "The selected camera is already in use."
msgstr "Den valda kameran används redan."

#: src/backend/camerapreviewsession.cpp:540
msgid "The selected camera has no usable preview format."
msgstr "Den valda kameran saknar ett användbart förhandsvisningsformat."

#: src/backend/camerapreviewsession.cpp:542
msgid "The camera did not start in time."
msgstr "Kameran startade inte i tid."

#: src/backend/camerapreviewsession.cpp:544
msgid "The camera preview stopped delivering frames."
msgstr "Kameraförhandsvisningen slutade leverera bildrutor."

#: src/backend/camerapreviewsession.cpp:546
msgid "The camera worker returned invalid data."
msgstr "Kameraprocessen returnerade ogiltiga data."

#: src/backend/camerapreviewsession.cpp:548
msgid "The camera worker stopped unexpectedly."
msgstr "Kameraprocessen stoppades oväntat."

#: src/backend/camerapreviewsession.cpp:549
msgid "The local camera is unavailable."
msgstr "Den lokala kameran är inte tillgänglig."

#: src/backend/supportreport.cpp:25
msgid "SupportReport"
msgstr "Support"

#: src/backend/supportreport.cpp:82
msgid "The redacted support report was copied."
msgstr "Den maskerade supportrapporten kopierades."

#: src/backend/supportreport.cpp:86
msgid "The text could not be copied."
msgstr "Texten kunde inte kopieras."

#: src/backend/supportreport.cpp:103 src/backend/supportreport.cpp:113
msgid "The support report could not be exported."
msgstr "Supportrapporten kunde inte exporteras."

#: src/backend/supportreport.cpp:119
msgid "The redacted support report was exported to Documents."
msgstr "Den maskerade supportrapporten exporterades till Dokument."

#: src/backend/supportreport.cpp:144
msgid "The camera is in use"
msgstr "Kameran används"

#: src/backend/supportreport.cpp:146
msgid "The camera is unavailable"
msgstr "Kameran är inte tillgänglig"

#: src/backend/supportreport.cpp:148
msgid "The native engine is unavailable"
msgstr "Native-motorn är inte tillgänglig"

#: src/backend/supportreport.cpp:150
msgid "The native protocol is unavailable"
msgstr "Native-protokollet är inte tillgängligt"

#: src/backend/supportreport.cpp:151
msgid "KFaceAuth needs attention"
msgstr "KFaceAuth behöver åtgärdas"

#: src/backend/supportreport.cpp:157
msgid "Close applications using the camera, then retry the preview."
msgstr ""
"Stäng program som använder kameran och försök sedan med förhandsvisningen "
"igen."

#: src/backend/supportreport.cpp:159
msgid "Reconnect or re-enable the camera, then refresh camera discovery."
msgstr ""
"Anslut eller aktivera kameran igen och uppdatera sedan kameraidentifieringen."

#: src/backend/supportreport.cpp:161
msgid ""
"No action is required in Milestone 1. Biometric and PAM operations remain "
"disabled."
msgstr ""
"Ingen åtgärd krävs i milstolpe 1. Biometriska åtgärder och PAM-åtgärder "
"förblir inaktiverade."

#: src/backend/supportreport.cpp:163
msgid "No known issue is currently reported."
msgstr "Inget känt problem rapporteras just nu."

#: src/backend/supportreport.cpp:164
msgid ""
"Keep unsupported operations disabled and export the redacted report for "
"development support."
msgstr ""
"Behåll åtgärder som inte stöds inaktiverade och exportera den maskerade "
"rapporten för utvecklingssupport."

#: src/backend/systemprobe.cpp:19
msgid "SystemProbe"
msgstr "SystemProbe"

#: src/backend/systemprobe.cpp:94
msgid "Live local system"
msgstr "Lokalt system i realtid"

#: src/backend/systemprobe.cpp:109
msgid "Native engine unavailable"
msgstr "Native-motorn är inte tillgänglig"

#: src/backend/systemprobe.cpp:111
msgid ""
"The KCM remains usable for camera checks. Biometric and PAM operations are "
"not implemented."
msgstr ""
"KCM-modulen kan fortfarande användas för kamerakontroller. Biometriska "
"åtgärder och PAM-åtgärder är inte implementerade."

#: src/backend/systemprobe.cpp:119
msgid "Native protocol unavailable"
msgstr "Native-protokollet är inte tillgängligt"

#: src/backend/systemprobe.cpp:120
msgid ""
"The local engine did not provide the versioned Milestone 1 status protocol."
msgstr ""
"Den lokala motorn tillhandahöll inte det versionshanterade statusprotokollet "
"för milstolpe 1."

#: src/backend/systemprobe.cpp:126
msgid "Native engine skeleton available"
msgstr "Native-motorns skelett är tillgängligt"

#: src/backend/systemprobe.cpp:128
msgid ""
"Status reporting is available. Recognition, enrollment, template storage, "
"and PAM remain disabled."
msgstr ""
"Statusrapportering är tillgänglig. Igenkänning, registrering, mallagring och "
"PAM förblir inaktiverade."

#: src/backend/visionanalysissession.cpp:44
msgid "VisionAnalysisSession"
msgstr "VisionAnalysisSession"

#: src/backend/visionanalysissession.cpp:96
msgid "Analyze one current preview frame when you choose."
msgstr "Analysera en aktuell förhandsvisningsruta när du själv väljer."

#: src/backend/visionanalysissession.cpp:315
msgid "Replacing the previous analysis with the current frame…"
msgstr "Ersätter den föregående analysen med den aktuella bildrutan…"

#: src/backend/visionanalysissession.cpp:316
msgid "Analysis was cancelled and its in-memory data was cleared."
msgstr "Analysen avbröts och dess data i minnet rensades."

#: src/backend/visionanalysissession.cpp:341
msgid "Analyzing one in-memory frame…"
msgstr "Analyserar en bildruta i minnet…"

#: src/backend/visionanalysissession.cpp:388
msgid "Starting local vision analysis…"
msgstr "Startar lokal bildanalys…"

#: src/backend/visionanalysissession.cpp:436
msgid "Finishing local analysis and clearing process data…"
msgstr "Slutför lokal analys och rensar processdata…"

#: src/backend/visionanalysissession.cpp:471
msgid "One-frame analysis is complete. No image was saved."
msgstr "Analysen av en bildruta är klar. Ingen bild sparades."

#: src/backend/visionanalysissession.cpp:621
msgid "Local vision analysis could not be started."
msgstr "Den lokala bildanalysen kunde inte startas."

#: src/backend/visionanalysissession.cpp:623
msgid "Local vision analysis did not start in time."
msgstr "Den lokala bildanalysen startade inte i tid."

#: src/backend/visionanalysissession.cpp:625
msgid "The one-frame analysis timed out."
msgstr "Tidsgränsen för analysen av en bildruta överskreds."

#: src/backend/visionanalysissession.cpp:627
msgid "Local vision analysis did not stop cleanly."
msgstr "Den lokala bildanalysen stoppades inte korrekt."

#: src/backend/visionanalysissession.cpp:629
msgid "Local vision analysis stopped unexpectedly."
msgstr "Den lokala bildanalysen stoppades oväntat."

#: src/backend/visionanalysissession.cpp:631
msgid "An outdated analysis response was rejected."
msgstr "Ett inaktuellt analyssvar avvisades."

#: src/backend/visionanalysissession.cpp:633
msgid "The current preview frame could not be analyzed."
msgstr "Den aktuella förhandsvisningsrutan kunde inte analyseras."

#: src/backend/visionanalysissession.cpp:635
msgid ""
"YuNet is unavailable or failed model verification. Reinstall KFaceAuth and "
"try again."
msgstr ""
"YuNet är inte tillgängligt eller klarade inte modellverifieringen. Installera "
"om KFaceAuth och försök igen."

#: src/backend/visionanalysissession.cpp:637
msgid ""
"The local YuNet detector returned invalid data. Try another frame or "
"reinstall OpenCV."
msgstr ""
"Den lokala YuNet-detektorn returnerade ogiltiga data. Försök med en annan "
"bildruta eller installera om OpenCV."

#: src/backend/visionanalysissession.cpp:639
msgid "Local vision analysis could not process this frame."
msgstr "Den lokala bildanalysen kunde inte bearbeta den här bildrutan."

#: src/backend/visionanalysissession.cpp:640
msgid "Local vision analysis returned invalid data."
msgstr "Den lokala bildanalysen returnerade ogiltiga data."

