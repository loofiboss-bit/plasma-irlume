#: src/preview/cameraprovider.cpp:192
msgid "Camera"
msgstr "Kamera"

#: src/kcm/ui/CameraCheckPage.qml:18 src/kcm/ui/CameraCheckPage.qml:36
#: src/kcm/ui/main.qml:31
msgid "Camera Check"
msgstr "Kamerakontroll"

#: src/kcm/ui/CameraCheckPage.qml:44
msgid ""
"Preview starts only when you ask. Frames remain in memory, stop after 60 "
"seconds, and are never used for enrollment or recognition."
msgstr ""
"Förhandsvisningen startar endast när du begär det. Bildrutor stannar i "
"minnet, stoppas efter 60 sekunder och används aldrig för registrering eller "
"igenkänning."

#: src/kcm/ui/CameraCheckPage.qml:51
msgid ""
"A visible RGB or infrared image does not verify liveness, identity, security "
"level, or authentication readiness."
msgstr ""
"En synlig RGB- eller infraröd bild verifierar inte livskontroll, identitet, "
"säkerhetsnivå eller autentiseringsberedskap."

#: src/kcm/ui/CameraCheckPage.qml:66
msgid "Local camera"
msgstr "Lokal kamera"

#: src/kcm/ui/CameraCheckPage.qml:73
msgid "Refresh"
msgstr "Uppdatera"

#: src/kcm/ui/CameraCheckPage.qml:86
msgid "Private camera preview"
msgstr "Privat kameraförhandsvisning"

#: src/kcm/ui/CameraCheckPage.qml:100
